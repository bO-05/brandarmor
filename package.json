{
    "name": "brandarmor",
    "version": "0.5.0",
    "private": true,
    "scripts": {
        "predev": "node scripts/patch-next-trace.cjs",
        "dev": "next dev -p 3015",
        "predev:3000": "node scripts/patch-next-trace.cjs",
        "dev:3000": "next dev -p 3000",
        "build": "next build",
        "start": "next start",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "verify:env": "node scripts/verify-environment.cjs",
        "verify:core": "node --experimental-strip-types --loader ./tests/loader.js tests/core-workflow-direct-verify.mjs",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "node scripts/verify-database-env.mjs && drizzle-kit migrate"
    },
    "dependencies": {
        "@clerk/nextjs": "7.6.0",
        "@neondatabase/serverless": "^1.1.0",
        "@react-pdf/renderer": "^4.3.0",
        "@vercel/speed-insights": "^2.0.0",
        "drizzle-orm": "^0.45.2",
        "lucide-react": "^0.460.0",
        "next": "16.2.11",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "sharp": "0.35.3",
        "sonner": "^1.7.0",
        "zod": "^3.24.0"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.0.0",
        "@types/node": "^22.0.0",
        "@types/react": "^19.1.0",
        "@types/react-dom": "^19.1.0",
        "drizzle-kit": "^0.31.10",
        "postcss": "^8.5.0",
        "tailwindcss": "^4.0.0",
        "typescript": "^5.7.0",
        "vitest": "^3.1.0"
    },
    "type": "module",
    "engines": {
        "node": ">=20.19.0"
    },
    "overrides": {
        "postcss": "$postcss",
        "sharp": "0.35.3"
    },
    "imports": {
        "@/*": "./src/*"
    }
}
